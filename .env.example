# JARVIS Core Environment Configuration

# Ollama LLM
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Logging
LOG_LEVEL=INFO

# Database
DB_PATH=data/jarvis.sqlite

# Browser Automation
BROWSER_HEADLESS=false

# TTS Engine: "edge-tts" or "pyttsx3"
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-GuyNeural
